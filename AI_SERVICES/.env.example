# =============================================================================
# 🌾 RICE VISION AI — TOKEN & SYSTEM CONFIGURATION TEMPLATE
# =============================================================================
# Copy file này thành .env và điền thông tin của bạn.
# File .env đã được cấu hình trong .gitignore để bảo mật tuyệt đối.

# --- 1. CẤU HÌNH NGROK (Dùng cho Google Colab GPU) ---
# Lấy Auth Token tại: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=

# Tên miền tĩnh cố định miễn phí (lấy tại Cloud Edge -> Domains)
# Ví dụ: your-subdomain.ngrok-free.app
# Nếu để trống, Colab sẽ tự tạo link ngẫu nhiên mỗi lần chạy
NGROK_DOMAIN=

# --- 2. CẤU HÌNH KẾT NỐI HỆ THỐNG ---
# URL máy chủ AI mà Web Gateway (Node.js) sẽ kết nối tới
# Mặc định local: http://localhost:8000
# Nếu dùng Colab tĩnh: https://your-subdomain.ngrok-free.app
AI_SERVER_URL=http://localhost:8000

# --- 3. CỔNG MẠNG (PORTS) ---
PORT_AI=8000
PORT_GATEWAY=3000
MAX_CONCURRENT_INFERENCES=1

# --- 4. CẤU HÌNH ĐƯỜNG DẪN MÔ HÌNH (TÙY CHỌN - ĐỔI MÔ HÌNH KHÔNG CẦN SỬA CODE) ---
# Nếu bỏ trống hoặc chú thích, hệ thống tự động tìm kiếm đường dẫn mặc định trong kho artifacts/ hoặc nguồn repo.
# Đường dẫn tương đối được tính từ thư mục AI_SERVICES/.

# Thiết bị suy luận YOLO: auto (mặc định: dùng cuda:0 nếu có GPU, cpu nếu không), cpu, cuda, cuda:0
# YOLO_DEVICE=auto

# Mô hình YOLO Segmentation (file .pt)
# YOLO_MODEL_PATH=artifacts/yolo/best.pt
# YOLO_MODEL_PATH=../YOLO_SEGMENTATION_TRAINING_WORKFLOW/runs/segment/runs/segment/train2/weights/best.pt

# Mô hình CNN Phân loại hạt (file .keras)
# CNN_MODEL_PATH=artifacts/cnn/best_model.keras
# CNN_MODEL_PATH=../CNN_CLASSIFICATION_MODEL/runs/train_dense/best_model.keras

# Thư mục chứa mô hình hồi quy (chứa model.joblib + scaler.joblib + config.json hoặc adapter legacy)
# REGRESSION_MODEL_DIR=artifacts/regression/production
# REGRESSION_MODEL_DIR=../LINEAR_REGRESSION_MODEL/models/ard
# REGRESSION_MODEL_DIR=../LINEAR_REGRESSION_MODEL/models
