# Normalize source, configuration, documentation, and notebooks to LF.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Images, archives, datasets, documents, audio, and model artifacts are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tif binary
*.tiff binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
